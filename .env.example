# Copy this file to .env and adjust as needed, then run: docker compose up -d

# --- App container ---
APP_PORT=8090

# --- Database ---
# Default: connects to a MySQL server already running on your Windows machine
# (host.docker.internal is Docker Desktop's DNS name for "the host PC" - do
# NOT use "localhost" here, that would mean the container itself, not your PC).
DB_HOST=host.docker.internal
DB_USER=root
DB_PASSWORD=!ngre55Ee
DB_NAME=mrin_project_ipsb

# Want a self-contained MySQL in a container instead, with no dependency on
# anything already running on your machine? Set DB_HOST=db above, and start
# with the bundled-db profile enabled:
#   docker compose --profile bundled-db up -d --build
DB_PORT=3306

# --- phpMyAdmin --- (points at whatever DB_HOST above is set to)
PMA_PORT=8081
