# Copy this file to .env and adjust as needed, then run: docker compose up -d

# --- App container ---
APP_PORT=8080

# --- Database (used by both the app container and the bundled MySQL container) ---
# Set DB_HOST=db to use the bundled MySQL container (default).
# Set DB_HOST=host.docker.internal to connect to a MySQL server already running
# on your own machine instead of the bundled one (then you can remove/ignore the
# "db" service in docker-compose.yml).
DB_HOST=db
DB_USER=root
DB_PASSWORD=!ngre55Ee
DB_NAME=mrin_project_ipsb
DB_PORT=3306

# --- phpMyAdmin ---
PMA_PORT=8081
